+        }
+        for (uint32_t i = 0; i < res.n_tokens; ++i) {
+            if (pmin < 0 || res.pos[i] < pmin) {
+                pmin = (int32_t) res.pos[i];
+            }
+            if (res.pos[i] > pmax) {
+                pmax = (int32_t) res.pos[i];
+            }
+        }
+        g_llb_watch.record(this, LLB_OP_UBATCH, res.n_tokens, smin, smax, pmin, pmax);
+    }
+
     return res;
 }
 
